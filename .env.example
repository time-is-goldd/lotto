# Supabase — Settings > API 에서 확인 (Phase 1에서 프로젝트 생성 후 값 입력)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 전용. 절대 NEXT_PUBLIC_ 접두사를 붙이지 않는다 (클라이언트 노출 시 전체 DB 노출 위험)
SUPABASE_SERVICE_ROLE_KEY=

# 사이트 절대경로 (OG 이미지, sitemap, 공유 링크 생성에 사용)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 카카오 개발자 콘솔(Application > 앱 키)에서 발급. 로그인/공유 연동은 Phase 2 이후 사용
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
NEXT_PUBLIC_KAKAO_JS_KEY=

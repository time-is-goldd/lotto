# Supabase — Settings > API 에서 확인 (Phase 1에서 프로젝트 생성 후 값 입력)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 전용. 절대 NEXT_PUBLIC_ 접두사를 붙이지 않는다 (클라이언트 노출 시 전체 DB 노출 위험)
SUPABASE_SERVICE_ROLE_KEY=

# 사이트 절대경로 (OG 이미지, sitemap, 공유 링크 생성에 사용)
# 끝에 "/"를 붙이지 않는다 (sitemap/canonical URL에 이중 슬래시가 생김 — lib/utils/env.ts의
# getSiteUrl()이 Vercel 배포 환경에서 이 값의 형식을 강제 검증한다).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 카카오 개발자 콘솔(Application > 앱 키)에서 발급. 로그인/공유 연동은 Phase 2 이후 사용
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
NEXT_PUBLIC_KAKAO_JS_KEY=

# Vercel Cron(로또 공식 결과 자동 동기화, /api/cron/sync-lotto)이 Vercel에서 실행될 때
# 자동으로 보내는 Authorization: Bearer 헤더 검증용. Vercel 프로젝트 설정(Environment
# Variables)에 직접 값을 생성해 등록한다 — 이 파일에는 이름만 남기고 값은 절대 커밋하지 않는다.
CRON_SECRET=

# 동행복권 공식 소스가 접근 불가능할 때 보조 출처(lottis.kr, datalotto.kr) 2곳이 완전히
# 일치하는 경우에만 자동 등록을 허용할지 여부. 정확히 문자열 "true"일 때만 켜진다(그 외
# 값/미설정은 전부 꺼짐 — fail-closed 기본값). 초기 운영은 꺼둔 채로 시작하는 것을 권장한다
# (docs/LOTTO_MULTI_SOURCE_FALLBACK_REPORT.md 참조).
LOTTO_SECONDARY_FALLBACK_ENABLED=

# lib/analytics/trackProductEvent.ts가 전송할 분석 이벤트 수집 endpoint(자체 서버 또는
# 분석 provider가 제공하는 URL). 비워두면 개발 환경 콘솔 로그만 남기고 아무 데이터도 외부로
# 나가지 않는다(fail-closed 기본값, docs/analytics.md 참조). NEXT_PUBLIC_ 접두사가 필요하다 —
# 이 값 자체는 어디로 이벤트를 보낼지일 뿐 비밀값이 아니다.
NEXT_PUBLIC_ANALYTICS_ENDPOINT=
